{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "ingress"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "reference"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "host"
      ],
      "properties": {
        "className": {
          "enum": [
            "alb",
            "nginx"
          ]
        },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$"
        },
        "publicSubnets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^subnet-([a-f0-9]{8}|[a-f0-9]{17})$"
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "mongodbTLS": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "clusterResources": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        }
      },
      "required": [
        "create"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "className": {
                "const": "alb"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "image": {
            "properties": {
              "reference": {
                "pattern": "^[a-z0-9./_-]+@sha256:[a-f0-9]{64}$"
              }
            }
          },
          "ingress": {
            "required": [
              "publicSubnets"
            ],
            "properties": {
              "host": {
                "const": ""
              },
              "publicSubnets": {
                "minItems": 2
              }
            }
          }
        }
      }
    }
  ]
}
